{
    "layer": "top",
    "position": "top",
    "height": 32,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "margin-bottom": 0,
    "exclusive": true,
    "spacing": 0,

    "modules-left": [
        "clock",
        "custom/weather"
    ],

    "modules-center": [],

    "modules-right": [
        "memory",
        "disk",
        "pulseaudio",
        "custom/discord",
        "tray"
    ],

    "clock": {
        "format": "  {:%a %d %b  %H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "interval": 60
    },

    "custom/weather": {
        "exec": "curl -s 'https://wttr.in/?format=%c+%t+%h' 2>/dev/null | tr -d '\n' || echo '  N/A'",
        "interval": 1800,
        "format": "{}",
        "tooltip": false
    },

    "memory": {
        "interval": 5,
        "format": "  RAM {percentage}%",
        "tooltip-format": "Used: {used:0.1f}G / {total:0.1f}G",
        "states": {
            "warning": 70,
            "critical": 90
        }
    },

    "disk": {
        "interval": 30,
        "format": "  DISK {percentage_used}%",
        "path": "/",
        "tooltip-format": "Used: {used} / {total}"
    },

    "pulseaudio": {
        "format": "  {volume}%",
        "format-muted": "  MUTED",
        "scroll-step": 5,
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "tooltip-format": "{desc} — {volume}%",
        "states": {
            "muted": 0
        }
    },

    "custom/discord": {
        "exec": "pgrep -x discord > /dev/null && echo ' DISCORD' || echo ''",
        "interval": 5,
        "format": "{}",
        "tooltip": false
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}

